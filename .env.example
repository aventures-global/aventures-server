# Server
PORT=3001

# Neon Postgres connection string (from Neon console → Connection details)
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Vite customer origin for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional future admin app origin
# ADMIN_ORIGIN=http://localhost:5174

# Neon Auth (Managed Better Auth endpoint)
NEON_AUTH_URL=https://ep-xxxx.region.aws.neon.tech/neondb/auth

# Comma-separated emails promoted to ADMIN on bootstrap
ADMIN_EMAILS=you@example.com

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aventures-assets
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
