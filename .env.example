PORT=3001
# Local only: "development" turns off the inquiry form rate limit. Leave unset or "production" when deployed.
NODE_ENV=development

CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"
NEON_AUTH_URL=https://ep-xxxx.region.aws.neon.tech/neondb/auth

# Always SUPER_ADMIN on login; only super admins can invite people or change roles.
# First-time setup: apply migrations (npx prisma migrate deploy), make sure
# admin@aventurestravel.com has an account (sign up on the public site), then log in to the admin
# site once. Invite teammates from the profile menu > Settings > Team & access after they have
# signed in to the website once; they become staff or admin when they accept the emailed link.
SUPER_ADMIN_EMAILS=admin@aventurestravel.com
# Promoted to ADMIN on first login only, so later demotions stick.
ADMIN_EMAILS=

# Cloudflare R2 (public CMS media + private documents under private/documents/).
# Use a custom domain on the bucket — do not rely on *.r2.dev in production.
# Ensure the public custom domain does not serve the private/ prefix (or use a separate private bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aventures
R2_PUBLIC_BASE_URL=https://assets.aventurestravel.com

# Cloudflare Email Service (REST API over HTTPS) for website inquiry forms and staff invitations.
# Invitation links point at ADMIN_ORIGIN, so set it to the deployed admin site URL in production.
# API token with "Email Sending: Edit"
CF_API_TOKEN=
# Cloudflare account that owns the sending domain
CF_ACCOUNT_ID=
# Must be an address on a domain onboarded under Email Service -> Email Sending
MAIL_FROM="AVENtures <admin@aventurestravel.com>"
# Inbox that receives inquiries (visitor email is set as Reply-To)
MAIL_TO=admin@aventurestravel.com
# Public site origin; emails load the logo from <PUBLIC_SITE_URL>/logo.png
PUBLIC_SITE_URL=https://aventures-client.vercel.app

# Identifies this app to OpenStreetMap Nominatim (required by its usage policy) for "closest destination" suggestions
GEOCODER_USER_AGENT="AVENtures/1.0 (admin@aventurestravel.com)"

# Set when running behind a reverse proxy (e.g. 1) so rate limiting sees real client IPs
# TRUST_PROXY=1

# PHP per 1 USD — used for quotation PDF “Approx. PHP” rows and one-time PHP→USD ledger conversion.
# Override to match your preferred reference rate (default 58).
# USD_PHP_RATE=58

# Stripe Checkout for quotation share payments (remaining booking balance).
# Ledger currency is USD. When a customer prefers PHP, Checkout enables Adaptive Pricing
# so Stripe presents a local currency while you settle in USD — enable Adaptive Pricing
# in the Stripe Dashboard (Payments settings) and keep USD as a settlement currency.
# Use test keys locally; webhook endpoint is POST /api/stripe/webhook
# (Stripe CLI: stripe listen --forward-to localhost:3001/api/stripe/webhook).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
