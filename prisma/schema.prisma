generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
  SUPER_ADMIN
}

model User {
  id                   String            @id
  email                String?           @unique
  firstName            String?
  lastName             String?
  phone                String?
  profilePicture       String?
  /// Customer checkout presentment preference; ledger amounts stay in booking currency (USD by default).
  preferredCurrency    String            @default("USD")
  role                 UserRole          @default(CUSTOMER)
  cartItems            CartItem[]
  preference           UserPreference?
  invitations          StaffInvitation[] @relation("InvitedUser")
  sentInvitations      StaffInvitation[] @relation("InvitedBy")
  auditActions         AuditLog[]        @relation("AuditActor")
  auditEntries         AuditLog[]        @relation("AuditSubject")
  ownedFolders         FileFolder[]      @relation("FolderOwner")
  createdFolders       FileFolder[]      @relation("FolderCreator")
  ownedFiles           ManagedFile[]     @relation("FileOwner")
  uploadedFiles        ManagedFile[]     @relation("FileUploader")
  createdShares        DocumentShare[]   @relation("ShareCreator")
  customerQuotations   Quotation[]       @relation("QuotationCustomer")
  createdQuotations    Quotation[]       @relation("QuotationCreator")
  updatedQuotations    Quotation[]       @relation("QuotationUpdater")
  createdQuoteShares   QuotationShare[]  @relation("QuotationShareCreator")
  customerBookings     Booking[]         @relation("BookingCustomer")
  customerPayments     Payment[]         @relation("PaymentCustomer")
  createdPayments      Payment[]         @relation("PaymentCreator")
  voidedPayments       Payment[]         @relation("PaymentVoider")
  createdFinanceEntries FinanceEntry[]   @relation("FinanceEntryCreator")
  voidedFinanceEntries FinanceEntry[]    @relation("FinanceEntryVoider")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

/// Personal admin-site preferences; one row per user, created on first save.
model UserPreference {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme     String   @default("system")
  accent    String   @default("royal")
  font      String   @default("poppins")
  textSize  String   @default("default")
  density   String   @default("comfortable")
  motion    String   @default("system")
  updatedAt DateTime @updatedAt
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

/// Promotion to STAFF or ADMIN only takes effect once the invited user accepts by email link.
model StaffInvitation {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation("InvitedUser", fields: [userId], references: [id], onDelete: Cascade)
  role        UserRole
  invitedById String?
  invitedBy   User?            @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  tokenHash   String           @unique
  expiresAt   DateTime
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?

  @@index([userId, status])
  @@index([status, createdAt])
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?
  actor         User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  subjectUserId String?
  subjectUser   User?    @relation("AuditSubject", fields: [subjectUserId], references: [id], onDelete: SetNull)
  action        String
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now())

  @@index([subjectUserId, createdAt])
  @@index([actorId, createdAt])
}

/// Key-value configuration rows (`business`, `role-permissions`).
model AppSetting {
  id        String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Tour {
  id               String   @id
  slug             String   @unique
  title            String
  tagline          String
  shortDescription String
  coverImage       String
  location         String
  experiences      Json     @default("[]")
  storyTitles      String[] @default([])
  travelTips       String[] @default([])
  featured         Boolean  @default(false)
  region           String   @default("other")
  sortOrder        Float    @default(0)
  searchText       String   @default("")
  lat              Float?
  lng              Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([sortOrder])
}

model GeocodeCache {
  query     String   @id
  lat       Float?
  lng       Float?
  label     String?
  country   String?
  placeType String?
  createdAt DateTime @default(now())
}

model MerchProduct {
  id          String        @id
  slug        String        @unique
  name        String
  tagline     String
  description String
  priceCents  Int
  currency    String        @default("USD")
  categoryId  String
  category    MerchCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  coverImage  String
  gallery     String[]
  sizes       String[]      @default([])
  inStock     Boolean       @default(true)
  cartItems   CartItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([categoryId])
}

/// `id` is a stable key derived from the first name (e.g. "photography"); renaming only changes `name`.
model MerchCategory {
  id        String         @id
  name      String         @unique
  sortOrder Int            @default(0)
  products  MerchProduct[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([sortOrder])
}

model Partner {
  id          String   @id
  name        String
  url         String   @default("")
  description String   @default("")
  logoSrc     String   @default("")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id
  quote     String
  name      String
  trip      String
  rating    Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FaqCategory {
  id        String             @id @default(cuid())
  name      String
  sortOrder Int                @default(0)
  faqs      FaqCategoryOnFaq[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([sortOrder])
}

model Faq {
  id         String             @id @default(cuid())
  question   String
  answer     String
  categories FaqCategoryOnFaq[]
  topEntry   FaqTopEntry?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model FaqCategoryOnFaq {
  faqId      String
  categoryId String
  faq        Faq         @relation(fields: [faqId], references: [id], onDelete: Cascade)
  category   FaqCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([faqId, categoryId])
  @@index([categoryId])
}

model FaqTopEntry {
  faqId     String   @id
  position  Int
  faq       Faq      @relation(fields: [faqId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([position])
}

/// Single row (`id = "catalog"`) holding the public visa pages, services, checklists, and finder.
model VisaCatalog {
  id        String   @id
  pages     Json
  services  Json
  finder    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One row per editable public page (`home`, `about`, `privacy`, `terms`).
model SitePage {
  id        String   @id
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CartItem {
  id             String       @id @default(cuid())
  userId         String
  merchProductId String
  size           String       @default("")
  qty            Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchProduct   MerchProduct @relation(fields: [merchProductId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, merchProductId, size])
  @@index([userId])
}

enum FileSpace {
  CUSTOMER
  INTERNAL
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocumentCategory {
  PASSPORT
  ID
  VISA
  SUPPORTING
  OTHER
}

model FileFolder {
  id          String      @id @default(cuid())
  space       FileSpace
  name        String
  parentId    String?
  parent      FileFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    FileFolder[] @relation("FolderTree")
  ownerUserId String?
  owner       User?       @relation("FolderOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?       @relation("FolderCreator", fields: [createdById], references: [id], onDelete: SetNull)
  files       ManagedFile[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([space, ownerUserId, parentId])
  @@index([parentId])
}

model ManagedFile {
  id           String           @id @default(cuid())
  space        FileSpace
  folderId     String?
  folder       FileFolder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  ownerUserId  String?
  owner        User?            @relation("FileOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  uploadedById String?
  uploadedBy   User?            @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  displayName  String
  category     DocumentCategory @default(OTHER)
  status       DocumentStatus   @default(PENDING)
  storageKey   String
  contentType  String
  sizeBytes    Int
  notes        String?
  deletedAt    DateTime?
  shares       DocumentShare[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([space, ownerUserId, deletedAt])
  @@index([folderId, deletedAt])
  @@index([status])
  @@index([category])
}

model DocumentShare {
  id            String    @id @default(cuid())
  fileId        String
  file          ManagedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  tokenHash     String    @unique
  createdById   String?
  createdBy     User?     @relation("ShareCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt     DateTime
  revokedAt     DateTime?
  downloadCount Int       @default(0)
  maxDownloads  Int?
  createdAt     DateTime  @default(now())

  @@index([fileId, createdAt])
  @@index([expiresAt])
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  CONVERTED
}

enum QuotationItemKind {
  SERVICE
  PACKAGE
  OPTIONAL
  OTHER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model Quotation {
  id               String            @id @default(cuid())
  number           String            @unique
  /// Null until the customer signs up with customerEmail; set immediately when quoting a registered user.
  customerUserId   String?
  customer         User?             @relation("QuotationCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  /// Snapshot used for PDF, email, and search even before an account exists.
  customerName     String
  customerEmail    String
  status           QuotationStatus   @default(DRAFT)
  currency         String            @default("USD")
  title            String
  notes            String?
  customerMessage  String?
  validUntil       DateTime?
  subtotalCents    Int               @default(0)
  optionalCents    Int               @default(0)
  totalCents       Int               @default(0)
  createdById      String?
  createdBy        User?             @relation("QuotationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?
  updatedBy        User?             @relation("QuotationUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  sentAt           DateTime?
  acceptedAt       DateTime?
  declinedAt       DateTime?
  convertedAt      DateTime?
  booking          Booking?
  pdfStorageKey    String?
  pdfContentType   String?
  pdfSizeBytes     Int?
  deletedAt        DateTime?
  items            QuotationItem[]
  shares           QuotationShare[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([customerUserId, createdAt])
  @@index([customerEmail])
  @@index([status, createdAt])
  @@index([deletedAt])
}

model QuotationItem {
  id          String            @id @default(cuid())
  quotationId String
  quotation   Quotation         @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  kind        QuotationItemKind @default(SERVICE)
  title       String
  description String?
  quantity    Int               @default(1)
  unitCents   Int
  lineCents   Int
  isOptional  Boolean           @default(false)
  selected    Boolean           @default(true)
  sortOrder   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([quotationId, sortOrder])
}

model QuotationShare {
  id            String     @id @default(cuid())
  quotationId   String
  quotation     Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  tokenHash     String     @unique
  createdById   String?
  createdBy     User?      @relation("QuotationShareCreator", fields: [createdById], references: [id], onDelete: SetNull)
  expiresAt     DateTime
  revokedAt     DateTime?
  viewCount     Int        @default(0)
  maxViews      Int?
  createdAt     DateTime   @default(now())

  @@index([quotationId, createdAt])
  @@index([expiresAt])
}

enum BookingPaymentStatus {
  UNPAID
  PARTIAL
  PAID
  OVERPAID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  GCASH
  MAYA
  CARD
  STRIPE
  OTHER
}

enum FinanceEntryType {
  INCOME
  EXPENSE
}

/// Thin booking row created from an accepted quotation; full workflow comes later.
model Booking {
  id             String               @id @default(cuid())
  /// Null when converted from an unregistered quotation; set when the customer signs up or was already linked.
  customerUserId String?
  customer       User?                @relation("BookingCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  quotationId    String?              @unique
  quotation      Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  status         BookingStatus        @default(PENDING)
  paymentStatus  BookingPaymentStatus @default(UNPAID)
  paidCents      Int                  @default(0)
  dueAt          DateTime?
  title          String
  currency       String               @default("USD")
  totalCents     Int
  notes          String?
  payments       Payment[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([customerUserId, createdAt])
  @@index([status, createdAt])
  @@index([paymentStatus, createdAt])
  @@index([dueAt])
}

model Payment {
  id                       String         @id @default(cuid())
  bookingId                String
  booking                  Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  /// Null for guest bookings until the customer account is claimed.
  customerUserId           String?
  customer                 User?          @relation("PaymentCustomer", fields: [customerUserId], references: [id], onDelete: Cascade)
  amountCents              Int
  currency                 String         @default("USD")
  method                   PaymentMethod
  paidAt                   DateTime       @default(now())
  notes                    String?
  reference                String?
  stripeCheckoutSessionId  String?        @unique
  stripePaymentIntentId    String?
  createdById              String?
  createdBy                User?          @relation("PaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt                 DateTime?
  voidedById               String?
  voidedBy                 User?          @relation("PaymentVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason               String?
  financeEntry             FinanceEntry?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@index([bookingId, paidAt])
  @@index([customerUserId, paidAt])
  @@index([voidedAt])
  @@index([paidAt])
}

model FinanceCategory {
  id         String           @id @default(cuid())
  name       String
  type       FinanceEntryType
  isSystem   Boolean          @default(false)
  sortOrder  Int              @default(0)
  archivedAt DateTime?
  entries    FinanceEntry[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([type, name])
  @@index([type, sortOrder])
}

model FinanceEntry {
  id          String           @id @default(cuid())
  type        FinanceEntryType
  categoryId  String
  category    FinanceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amountCents Int
  currency    String           @default("USD")
  occurredAt  DateTime         @default(now())
  description String
  notes       String?
  paymentId   String?          @unique
  payment     Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?            @relation("FinanceEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  voidedAt    DateTime?
  voidedById  String?
  voidedBy    User?            @relation("FinanceEntryVoider", fields: [voidedById], references: [id], onDelete: SetNull)
  voidReason  String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type, occurredAt])
  @@index([categoryId, occurredAt])
  @@index([occurredAt])
  @@index([voidedAt])
}
